{
  "name": "dsh-mobile-web-pkg",
  "description": "Dependency-only deploy root defining the Android on-device web-host closure; pnpm deploy materializes this manifest and node_modules.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "comment": "Legacy pnpm deploy runs with auto-install-peers=false, so every peer dependency reached at runtime must be listed explicitly. The list was enumerated by booting the deployed closure until no module was missing. Service-Definition packages are peers of their providers.",
